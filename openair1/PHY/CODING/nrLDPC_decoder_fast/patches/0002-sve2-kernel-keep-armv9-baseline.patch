SVE2 kernel: add SVE2 to the baseline ("+sve2") instead of setting "arch=armv8.5-a+sve2", which lowers an
Armv9 baseline (OAI on Neoverse-N2/V2, -mcpu=native on the Cortex-A720: GCC warns "__ARM_ARCH redefined").

--- a/src/kern_sve2.c
+++ b/src/kern_sve2.c
@@ -7,7 +7,7 @@
  *   predicated negation for the signs. */
 #include "ldpc_internal.h"
 #if defined(__aarch64__)
-#pragma GCC target("arch=armv8.5-a+sve2")
+#pragma GCC target("+sve2") /* adds SVE2 to the baseline (an "arch=" target would lower an Armv9 baseline) */
 #include <arm_sve.h>
 
 static inline svint8_t v_corr(svbool_t pg, svint8_t m, int nsh, svuint8_t nshv, svuint8_t vb)
